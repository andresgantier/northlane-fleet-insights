# Copy to .env.local and fill in. Never commit .env.local.
# Neon → project → Connect → connection string (pooled, role neondb_owner).
# Local only: migrations (npm run db:migrate) and import (npm run db:import). Never in Vercel.
DATABASE_URL=
# Read-only app login, written by npm run db:app-role. This is the one Vercel gets.
APP_DATABASE_PASSWORD=
APP_DATABASE_URL=
# Neon Auth (Phase 3)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Server only (never NEXT_PUBLIC_)
GEMINI_API_KEY=
DEMO_PASSWORD=
